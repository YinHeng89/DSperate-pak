+static bool unsafe_name(const char* name, size_t n) {
+  std::string s(name, n);
+  for (char& c : s) if (c == '\\') c = '/';
+  if (s.empty() || s[0] == '/') return true;
+  if (s.size() >= 2 && s[1] == ':') return true;
+  size_t start = 0;
